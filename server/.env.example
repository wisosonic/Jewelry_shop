# Server
PORT=4000
NODE_ENV=development
# One origin, or a comma-separated list, allowed by CORS (e.g.
# "http://localhost:5173,https://app.example.com") - see app.ts
CLIENT_ORIGIN=http://localhost:5173

# Database (SQLite now; swap to a mysql:// URL + provider="mysql" in schema.prisma to migrate)
DATABASE_URL="file:./dev.db"

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Metals.dev (https://metals.dev) - free tier key
METALS_API_KEY=your-metals-dev-api-key
METALS_API_BASE_URL=https://api.metals.dev/v1
METALS_CURRENCY=USD
# How often automatic price refresh runs (and the minimum gap enforced
# between any two refreshes, scheduled or manual) is set in-app now, not
# here - see Settings.metalPriceRefreshFrequencyMinutes, editable on
# Admin -> Settings (default 60 minutes).

# Twilio (https://www.twilio.com) - sends the registration OTP via SMS.
# Left as placeholders, the OTP is logged to the console instead (see
# src/modules/sms/sms.service.ts) so registration/verification still works
# locally without a real Twilio account.
TWILIO_ACCOUNT_SID=ACdummysid00000000000000000000
TWILIO_AUTH_TOKEN=dummy-auth-token-replace-me
TWILIO_PHONE_NUMBER=+10000000000
# OTP codes never expire (a shopper can verify whenever they get around to
# it) - this instead throttles how often a new one can be requested
OTP_RESEND_COOLDOWN_SECONDS=60

# Unverified-account cleanup (see src/modules/accountCleanup) - accounts that
# never complete OTP verification are warned, then deleted
UNVERIFIED_ACCOUNT_TTL_DAYS=14
UNVERIFIED_ACCOUNT_WARNING_DAYS_BEFORE_DELETION=3
# Cron schedule for the daily warn-then-delete pass (default: 3am)
ACCOUNT_CLEANUP_CRON=0 3 * * *

# Seed users
SEED_ADMIN_EMAIL=admin@nayasofia.com
SEED_ADMIN_PASSWORD=Admin1234!
SEED_USER_EMAIL=customer@nayasofia.com
SEED_USER_PASSWORD=Customer123!
